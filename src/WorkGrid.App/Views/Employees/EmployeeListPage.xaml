<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Employees"
             x:Class="WorkGrid.App.Views.Employees.EmployeeListPage"
             x:DataType="vm:EmployeeListViewModel"
             Title="Employees">

    <Grid RowDefinitions="*, Auto" Padding="20">
        <!-- Main Area for Lists / States -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="15" IsVisible="{Binding IsEmpty}">
            <Label Text="No Employees Found"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding StatusText}"
                   TextColor="Gray"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Floating action area -->
        <Button Grid.Row="1"
                Text="Add Employee"
                Command="{Binding AddEmployeeCommand}"
                Margin="10" />
    </Grid>
</ContentPage>
