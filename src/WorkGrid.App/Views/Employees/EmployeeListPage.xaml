<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Employees"
             xmlns:entities="clr-namespace:WorkGrid.Domain.Entities;assembly=WorkGrid.Domain"
             x:Class="WorkGrid.App.Views.Employees.EmployeeListPage"
             x:DataType="vm:EmployeeListViewModel"
             Title="Employees">

    <Grid RowDefinitions="Auto, *, Auto" Padding="15" RowSpacing="10">
        <!-- Search Bar -->
        <SearchBar Grid.Row="0"
                   Placeholder="Search name, code, email, department..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding LoadEmployeesCommand}" />

        <!-- Main List Area -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadEmployeesCommand}">
            <Grid>
                <!-- Empty State -->
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10"
                                     IsVisible="{Binding IsEmpty}">
                    <Label Text="No Employees Found"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Employee List -->
                <CollectionView ItemsSource="{Binding Employees}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Employee">
                            <Frame Margin="0,4"
                                   Padding="12"
                                   CornerRadius="8"
                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmployeeListViewModel}}, Path=SelectEmployeeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding EmployeeCode}"
                                           TextColor="Gray"
                                           FontSize="13" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Email}"
                                           TextColor="Gray"
                                           FontSize="13" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Department}"
                                           TextColor="#512BD4"
                                           FontSize="13"
                                           FontAttributes="Italic" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

        <!-- Bottom Action Button -->
        <Button Grid.Row="2"
                Text="+ Add Employee"
                Command="{Binding AddEmployeeCommand}"
                Margin="0,5,0,0" />
    </Grid>
</ContentPage>
