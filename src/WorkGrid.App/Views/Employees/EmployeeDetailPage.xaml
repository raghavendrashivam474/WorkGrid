<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Employees"
             xmlns:common="clr-namespace:WorkGrid.App.ViewModels.Common"
             x:Class="WorkGrid.App.Views.Employees.EmployeeDetailPage"
             x:DataType="vm:EmployeeDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <!-- Error Banner -->
            <Frame BackgroundColor="#FFEBEE"
                   BorderColor="#D32F2F"
                   Padding="10"
                   CornerRadius="6"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#D32F2F"
                       FontSize="13" />
            </Frame>

            <!-- Employee Code (Disabled if editing) -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Employee Code *" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding EmployeeCode}"
                       Placeholder="e.g. EMP001"
                       IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Name -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Full Name *" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding Name}"
                       Placeholder="e.g. Jane Doe" />
            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Email Address *" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding Email}"
                       Keyboard="Email"
                       Placeholder="e.g. jane.doe@company.com" />
            </VerticalStackLayout>

            <!-- Department -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Department" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding Department}"
                       Placeholder="e.g. Engineering" />
            </VerticalStackLayout>

            <!-- ── CURRENTLY ASSIGNED ASSETS (Edit Mode Only) ── -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditMode}">
                <Label Text="Currently Assigned Assets" FontAttributes="Bold" FontSize="15" TextColor="#512BD4" Margin="0,10,0,0" />
                <CollectionView ItemsSource="{Binding ActiveAssignments}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No active asset assignments." TextColor="Gray" FontSize="12" FontAttributes="Italic" Margin="4,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="common:AssignmentHistoryItem">
                            <Frame Margin="0,2" Padding="10" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding AssignedAt, StringFormat='Assigned: {0:d}'}" TextColor="Gray" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="Active" FontAttributes="Bold" TextColor="#2E7D32" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ── ASSIGNMENT HISTORY (Edit Mode Only) ── -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditMode}">
                <Label Text="Assignment History" FontAttributes="Bold" FontSize="15" TextColor="#512BD4" Margin="0,5,0,0" />
                <CollectionView ItemsSource="{Binding HistoryAssignments}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No past assignment history." TextColor="Gray" FontSize="12" FontAttributes="Italic" Margin="4,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="common:AssignmentHistoryItem">
                            <Frame Margin="0,2" Padding="10" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding AssignedAt, StringFormat='Period: {0:d} - '}" TextColor="DimGray" FontSize="11" />
                                    <Label Text="{Binding ReturnedAt, StringFormat='Returned: {0:d}'}" TextColor="DimGray" FontSize="11" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Actions -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,15,0,0">
                <Button Grid.Column="0"
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <!-- Delete Button (Only visible in edit mode) -->
            <Button Text="Delete Employee"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="#D32F2F"
                    TextColor="White"
                    Margin="0,10,0,0"
                    IsVisible="{Binding CanDelete}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            <!-- Activity Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
