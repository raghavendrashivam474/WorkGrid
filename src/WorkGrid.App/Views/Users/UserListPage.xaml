<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:usersVm="clr-namespace:WorkGrid.App.ViewModels.Users"
             xmlns:entities="clr-namespace:WorkGrid.Domain.Entities;assembly=WorkGrid.Domain"
             x:Class="WorkGrid.App.Views.Users.UserListPage"
             x:DataType="usersVm:UserListViewModel"
             Title="User Administration">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Error message banner -->
        <Frame Grid.Row="0"
               BackgroundColor="#FFEBEE"
               BorderColor="#D32F2F"
               CornerRadius="6"
               Margin="16,8,16,4"
               Padding="10"
               IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="#D32F2F"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </Frame>

        <!-- New User Form -->
        <Frame Grid.Row="1"
               Margin="16,8"
               Padding="14"
               CornerRadius="8"
               BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
               IsVisible="{Binding CanManageUsers}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Add New User" FontSize="16" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" RowDefinitions="Auto, Auto" RowSpacing="8">
                    <Entry Grid.Row="0" Grid.Column="0"
                           Placeholder="Username"
                           Text="{Binding NewUsername}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    <Entry Grid.Row="0" Grid.Column="1"
                           Placeholder="Display Name"
                           Text="{Binding NewDisplayName}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    <Entry Grid.Row="0" Grid.Column="2"
                           Placeholder="Password (min 6)"
                           IsPassword="True"
                           Text="{Binding NewPassword}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                    <Picker Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Title="Select Role"
                            ItemsSource="{Binding AvailableRoles}"
                            SelectedItem="{Binding NewRole}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                    <Button Grid.Row="1" Grid.Column="2"
                            Text="Create User"
                            Command="{Binding CreateUserCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="6" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Users List Area -->
        <Grid Grid.Row="2" Margin="16,8">
            <RefreshView IsRefreshing="{Binding IsBusy}"
                         Command="{Binding LoadUsersCommand}">
                <Grid>
                    <!-- Empty State Layout -->
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="10"
                                         IsVisible="{Binding IsEmpty}">
                        <Label Text="No Users Registered"
                               Style="{StaticResource SubHeadline}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="Gray"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Users List -->
                    <CollectionView ItemsSource="{Binding Users}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:User">
                                <Frame Margin="0,4"
                                       Padding="12"
                                       CornerRadius="8"
                                       BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <!-- User Info -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Username, StringFormat='@{0}'}"
                                                   FontSize="13"
                                                   TextColor="#64748B"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Role, StringFormat='Role: {0}'}"
                                                   FontSize="12"
                                                   TextColor="#0284C7"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <!-- Status Indicator -->
                                        <Label Grid.Column="1"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               FontSize="12"
                                               TextColor="{Binding IsActive, Converter={StaticResource ActiveStatusColorConverter}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="Active" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="Inactive" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- Status Toggle Action Button -->
                                        <Button Grid.Column="2"
                                                Text="Toggle Status"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type usersVm:UserListViewModel}}, Path=ToggleUserStatusCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type usersVm:UserListViewModel}}, Path=CanManageUsers}"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type usersVm:UserListViewModel}}, Path=IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                BackgroundColor="#475569"
                                                TextColor="White"
                                                FontSize="12"
                                                CornerRadius="6"
                                                HeightRequest="36" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </RefreshView>

            <!-- Loading Indicator Overlay -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               ZIndex="10"
                               Color="#2563EB" />
        </Grid>
    </Grid>
</ContentPage>