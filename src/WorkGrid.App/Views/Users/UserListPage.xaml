<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:usersVm="clr-namespace:WorkGrid.App.ViewModels.Users"
             xmlns:entities="clr-namespace:WorkGrid.Domain.Entities;assembly=WorkGrid.Domain"
             x:Class="WorkGrid.App.Views.Users.UserListPage"
             x:DataType="usersVm:UserListViewModel"
             Title="User Administration">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Error message banner -->
        <Frame Grid.Row="0"
               BackgroundColor="#FEE2E2"
               BorderColor="#EF4444"
               CornerRadius="6"
               Margin="16,8,16,4"
               Padding="10"
               IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="13" />
        </Frame>

        <!-- New User Form -->
        <Frame Grid.Row="1"
               Margin="16,8"
               Padding="14"
               CornerRadius="8"
               BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
               IsVisible="{Binding CanManageUsers}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Add New User" FontSize="16" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" RowDefinitions="Auto, Auto" RowSpacing="8">
                    <Entry Grid.Row="0" Grid.Column="0" Placeholder="Username" Text="{Binding NewUsername}" />
                    <Entry Grid.Row="0" Grid.Column="1" Placeholder="Display Name" Text="{Binding NewDisplayName}" />
                    <Entry Grid.Row="0" Grid.Column="2" Placeholder="Password (min 6)" IsPassword="True" Text="{Binding NewPassword}" />
                    
                    <Picker Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Title="Select Role"
                            ItemsSource="{Binding AvailableRoles}"
                            SelectedItem="{Binding NewRole}" />

                    <Button Grid.Row="1" Grid.Column="2"
                            Text="Create User"
                            Command="{Binding CreateUserCommand}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="6" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Users List -->
        <CollectionView Grid.Row="2"
                        Margin="16,8"
                        ItemsSource="{Binding Users}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:User">
                    <Frame Margin="0,4" Padding="12" CornerRadius="8">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Username, StringFormat='@{0}'}" FontSize="13" TextColor="#64748B" />
                                <Label Text="{Binding Role, StringFormat='Role: {0}'}" FontSize="12" TextColor="#0284C7" />
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   Text="{Binding IsActive, Converter={x:Null}, StringFormat='{0}'}"
                                   VerticalOptions="Center"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                            <Button Grid.Column="2"
                                    Text="Toggle Status"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type usersVm:UserListViewModel}}, Path=ToggleUserStatusCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#475569"
                                    TextColor="White"
                                    FontSize="12"
                                    CornerRadius="6"
                                    HeightRequest="36" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
