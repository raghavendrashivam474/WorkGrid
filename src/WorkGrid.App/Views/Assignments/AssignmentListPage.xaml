<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Assignments"
             x:Class="WorkGrid.App.Views.Assignments.AssignmentListPage"
             x:DataType="vm:AssignmentListViewModel"
             Title="Assignments">

    <Grid RowDefinitions="*, Auto" Padding="15">
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadAssignmentsCommand}">
            <Grid>
                <!-- Empty State -->
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10"
                                     IsVisible="{Binding IsEmpty}">
                    <Label Text="No Assignments Found"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Assignment List -->
                <CollectionView ItemsSource="{Binding Assignments}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssignmentDisplayItem">
                            <Frame Margin="0,4"
                                   Padding="12"
                                   CornerRadius="8"
                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AssignmentListViewModel}}, Path=SelectAssignmentCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                    <!-- G5: Truncate long Asset Tag + Asset Name safely without layout clipping -->
                                    <Label Grid.Row="0" Grid.Column="0" LineBreakMode="TailTruncation" VerticalOptions="Center" Margin="0,0,10,0">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding AssetTag}" FontAttributes="Bold" TextColor="#512BD4" FontSize="15" />
                                                <Span Text=" - " TextColor="Gray" />
                                                <Span Text="{Binding AssetName}" FontAttributes="Bold" FontSize="15" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontAttributes="Bold"
                                           TextColor="{Binding IsActive, Converter={StaticResource ActiveStatusColorConverter}}"
                                           FontSize="13"
                                           VerticalOptions="Center" />

                                    <!-- G5: Truncate long employee names safely -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding EmployeeName}"
                                           LineBreakMode="TailTruncation"
                                           TextColor="Gray"
                                           FontSize="13"
                                           Margin="0,4,0,0" />

                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding AssignedAt, StringFormat='Assigned: {0:g}'}"
                                           TextColor="DimGray"
                                           FontSize="11"
                                           Margin="0,4,0,0" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- G3: Loading Indicator overlaying empty list during initial fetch -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   ZIndex="10"
                                   Color="#512BD4" />
            </Grid>
        </RefreshView>

        <!-- Bottom Action Button - G7: Disabled when loading is in progress -->
        <Button Grid.Row="1"
                Text="+ Assign Asset"
                Command="{Binding AddAssignmentCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                Margin="0,10,0,0" />
    </Grid>
</ContentPage>