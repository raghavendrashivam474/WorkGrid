<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Assets"
             x:Class="WorkGrid.App.Views.Assets.AssetListPage"
             x:DataType="vm:AssetListViewModel"
             Title="Assets">

    <Grid RowDefinitions="*, Auto" Padding="20">
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="15" IsVisible="{Binding IsEmpty}">
            <Label Text="No Assets Found"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding StatusText}"
                   TextColor="Gray"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="Add Asset"
                Command="{Binding AddAssetCommand}"
                Margin="10" />
    </Grid>
</ContentPage>
