<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Assets"
             xmlns:entities="clr-namespace:WorkGrid.Domain.Entities;assembly=WorkGrid.Domain"
             x:Class="WorkGrid.App.Views.Assets.AssetListPage"
             x:DataType="vm:AssetListViewModel"
             Title="Assets">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="15" RowSpacing="8">
        <!-- Search Bar -->
        <SearchBar Grid.Row="0"
                   Placeholder="Search tag, name, serial number, type..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding LoadAssetsCommand}" />

        <!-- Status Filter Chips Picker -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Filter:" VerticalOptions="Center" FontAttributes="Bold" />
            <Picker Grid.Column="1"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter}"
                    Title="Filter by Status" />
        </Grid>

        <!-- Main List Area -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadAssetsCommand}">
            <Grid>
                <!-- Empty State -->
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10"
                                     IsVisible="{Binding IsEmpty}">
                    <Label Text="No Assets Found"
                           Style="{StaticResource SubHeadline}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Asset List -->
                <CollectionView ItemsSource="{Binding Assets}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Asset">
                            <Frame Margin="0,4"
                                   Padding="12"
                                   CornerRadius="8"
                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AssetListViewModel}}, Path=SelectAssetCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding AssetTag}"
                                           FontAttributes="Bold"
                                           TextColor="#512BD4"
                                           FontSize="14" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding AssetType}"
                                           TextColor="Gray"
                                           FontSize="13" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Status}"
                                           TextColor="DimGray"
                                           FontSize="13"
                                           FontAttributes="Italic" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

        <!-- Bottom Action Button -->
        <Button Grid.Row="3"
                Text="+ Add Asset"
                Command="{Binding AddAssetCommand}"
                Margin="0,5,0,0" />
    </Grid>
</ContentPage>
