<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Assets"
             x:Class="WorkGrid.App.Views.Assets.AssetDetailPage"
             x:DataType="vm:AssetDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <!-- Error Banner -->
            <Frame BackgroundColor="#FFEBEE"
                   BorderColor="#D32F2F"
                   Padding="10"
                   CornerRadius="6"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#D32F2F"
                       FontSize="13" />
            </Frame>

            <!-- Status Display & Lifecycle Actions (Edit Mode Only) -->
            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                   Padding="12"
                   CornerRadius="8"
                   IsVisible="{Binding IsEditMode}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Current Status:" FontAttributes="Bold" />
                        <Label Text="{Binding Status}" TextColor="#512BD4" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <!-- Transition buttons (disabled if retired) -->
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsRetired, Converter={StaticResource InverseBoolConverter}}">
                        <Button Text="Available"
                                Command="{Binding MarkAvailableCommand}"
                                FontSize="12"
                                HeightRequest="36"
                                Padding="10,0" />
                        <Button Text="Maintenance"
                                Command="{Binding MarkMaintenanceCommand}"
                                FontSize="12"
                                HeightRequest="36"
                                Padding="10,0"
                                BackgroundColor="#FF9800" />
                        <Button Text="Retire"
                                Command="{Binding RetireCommand}"
                                FontSize="12"
                                HeightRequest="36"
                                Padding="10,0"
                                BackgroundColor="#757575" />
                    </HorizontalStackLayout>

                    <Label Text="This asset is retired (terminal state)."
                           TextColor="Gray"
                           FontSize="12"
                           FontAttributes="Italic"
                           IsVisible="{Binding IsRetired}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Asset Tag (Disabled if editing) -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Asset Tag *" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding AssetTag}"
                       Placeholder="e.g. AST-001"
                       IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Name -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Asset Name *" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding Name}"
                       Placeholder="e.g. Dell Latitude 5520" />
            </VerticalStackLayout>

            <!-- Asset Type -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Asset Type" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding AssetType}"
                       Placeholder="e.g. Laptop, Monitor, Phone" />
            </VerticalStackLayout>

            <!-- Serial Number -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Serial Number" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding SerialNumber}"
                       Placeholder="e.g. SN-98218392" />
            </VerticalStackLayout>

            <!-- Actions -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,15,0,0">
                <Button Grid.Column="0"
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <!-- Delete Button (Only visible in edit mode) -->
            <Button Text="Delete Asset"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="#D32F2F"
                    TextColor="White"
                    Margin="0,10,0,0"
                    IsVisible="{Binding CanDelete}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            <!-- Activity Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
