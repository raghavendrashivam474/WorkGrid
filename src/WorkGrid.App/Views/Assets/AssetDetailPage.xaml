<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Assets"
             xmlns:common="clr-namespace:WorkGrid.App.ViewModels.Common"
             x:Class="WorkGrid.App.Views.Assets.AssetDetailPage"
             x:DataType="vm:AssetDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <!-- Error Banner -->
            <Frame BackgroundColor="#FFEBEE"
                   BorderColor="#D32F2F"
                   Padding="10"
                   CornerRadius="6"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#D32F2F"
                       FontSize="13" />
            </Frame>

            <!-- Status Display & Lifecycle Actions (Edit Mode Only) -->
            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"
                   Padding="12"
                   CornerRadius="8"
                   IsVisible="{Binding IsEditMode}">
                  <VerticalStackLayout Spacing="8">
                      <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                          <Label Text="Current Status:" FontAttributes="Bold" />
                          <Label Text="{Binding Status}" TextColor="#512BD4" FontAttributes="Bold" />
                      </HorizontalStackLayout>

                      <!-- Transition buttons governed by Lifecycle State -->
                      <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsRetired, Converter={StaticResource InverseBoolConverter}}">
                          <Button Text="Mark Available"
                                  Command="{Binding MarkAvailableCommand}"
                                  IsVisible="{Binding CanMarkAvailable}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                  FontSize="12"
                                  HeightRequest="36"
                                  Padding="10,0"
                                  BackgroundColor="#2E7D32"
                                  TextColor="White" />
                          <Button Text="Place in Maintenance"
                                  Command="{Binding MarkMaintenanceCommand}"
                                  IsVisible="{Binding CanMarkMaintenance}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                  FontSize="12"
                                  HeightRequest="36"
                                  Padding="10,0"
                                  BackgroundColor="#EF6C00"
                                  TextColor="White" />
                          <Button Text="Retire Asset"
                                  Command="{Binding RetireCommand}"
                                  IsVisible="{Binding CanRetire}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                  FontSize="12"
                                  HeightRequest="36"
                                  Padding="10,0"
                                  BackgroundColor="#757575"
                                  TextColor="White" />
                      </HorizontalStackLayout>

                      <Label Text="This asset is retired (terminal state)."
                             TextColor="Gray"
                             FontSize="12"
                             FontAttributes="Italic"
                             IsVisible="{Binding IsRetired}" />
                  </VerticalStackLayout>
            </Frame>

            <!-- Current Holder Card (Edit Mode Only) -->
            <Frame BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}"
                   Padding="12"
                   CornerRadius="8"
                   IsVisible="{Binding HasCurrentHolder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Current Holder" FontAttributes="Bold" TextColor="#1565C0" FontSize="14" />
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding CurrentHolderName}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="—" TextColor="Gray" />
                        <Label Text="{Binding CurrentHolderCode}" TextColor="Gray" FontSize="15" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding CurrentHolderAssignedAt, StringFormat='Holding since: {0:g}'}" TextColor="DimGray" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Asset Tag (Disabled if editing) -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Asset Tag *" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding AssetTag}"
                       Placeholder="e.g. AST-001"
                       ClearButtonVisibility="WhileEditing"
                       IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Name -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Asset Name *" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding Name}"
                       Placeholder="e.g. Dell Latitude 5520"
                       ClearButtonVisibility="WhileEditing"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Asset Type -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Asset Type" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding AssetType}"
                       Placeholder="e.g. Laptop, Monitor, Phone"
                       ClearButtonVisibility="WhileEditing"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Serial Number -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Serial Number" FontAttributes="Bold" FontSize="13" />
                <Entry Text="{Binding SerialNumber}"
                       Placeholder="e.g. SN-98218392"
                       ClearButtonVisibility="WhileEditing"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <!-- ── ASSIGNMENT HISTORY (Edit Mode Only) ── -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditMode}">
                <Label Text="Assignment History" FontAttributes="Bold" FontSize="15" TextColor="#512BD4" Margin="0,10,0,0" />
                <CollectionView ItemsSource="{Binding AssignmentHistory}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No assignment history for this asset." TextColor="Gray" FontSize="12" FontAttributes="Italic" Margin="4,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="common:AssignmentHistoryItem">
                            <Frame Margin="0,2" Padding="10" CornerRadius="6" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding AssignedAt, StringFormat='Assigned: {0:d}'}" TextColor="DimGray" FontSize="11" />
                                        <Label Text="{Binding ReturnedAt, StringFormat='Returned: {0:d}'}" TextColor="DimGray" FontSize="11" IsVisible="{Binding ReturnedAt, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding StatusDisplay}" TextColor="{Binding IsActive, Converter={StaticResource ActiveStatusColorConverter}}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Actions -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,15,0,0">
                <Button Grid.Column="0"
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="46" />
                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="46" />
            </Grid>

            <!-- Delete Button (Only visible in edit mode) -->
            <Button Text="Delete Asset"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="#D32F2F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="46"
                    Margin="0,10,0,0"
                    IsVisible="{Binding CanDelete}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            <!-- Activity Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
