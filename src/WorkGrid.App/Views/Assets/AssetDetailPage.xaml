<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Assets"
             x:Class="WorkGrid.App.Views.Assets.AssetDetailPage"
             x:DataType="vm:AssetDetailViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="{Binding Title}" Style="{StaticResource Headline}" />
        <Label Text="This page is ready for asset forms." TextColor="Gray" />
        
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
            <Button Text="Save" Command="{Binding SaveCommand}" WidthRequest="100" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" WidthRequest="100" Style="{StaticResource SecondaryButtonStyle}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
