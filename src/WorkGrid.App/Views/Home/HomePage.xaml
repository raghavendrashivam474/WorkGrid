<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkGrid.App.ViewModels.Home"
             x:Class="WorkGrid.App.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="{Binding Title}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="16">
                    <!-- Standardized Error Banner -->
                    <Frame BackgroundColor="#FFEBEE"
                           BorderColor="#D32F2F"
                           Padding="10"
                           CornerRadius="6"
                           IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#D32F2F"
                               FontSize="13" />
                    </Frame>

                    <!-- User Session & Logout Header -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding CurrentUserName, StringFormat='Hello, {0}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />
                            <Label Text="{Binding CurrentUserRole, StringFormat='Role: {0}'}"
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Sign Out"
                                Command="{Binding LogoutCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                BackgroundColor="#EF4444"
                                TextColor="White"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                HeightRequest="36"
                                Padding="12,0" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4" />

                    <!-- Welcome Title -->
                    <Label Text="Operational Overview" Style="{StaticResource Headline}" />
                    <Label Text="Live asset allocation and personnel metrics." TextColor="Gray" FontSize="14" />

                    <!-- High-level Summary Cards -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Frame Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#EDE7F6, Dark=#311B92}" CornerRadius="10" Padding="15">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Employees" FontSize="13" TextColor="#512BD4" FontAttributes="Bold" />
                                <Label Text="{Binding EmployeeCount}" FontSize="28" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E0F2F1, Dark=#004D40}" CornerRadius="10" Padding="15">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Total Assets" FontSize="13" TextColor="#00796B" FontAttributes="Bold" />
                                <Label Text="{Binding AssetCount}" FontSize="28" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Active Assignments Highlight -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}" CornerRadius="10" Padding="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Active Assignments" FontSize="14" FontAttributes="Bold" TextColor="#2E7D32" />
                                <Label Text="Assets currently checked out to team members" TextColor="DimGray" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding ActiveAssignmentCount}" FontSize="26" FontAttributes="Bold" TextColor="#2E7D32" VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <!-- Asset Breakdown -->
                    <Label Text="Asset Status Distribution" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                        <Frame Grid.Row="0" Grid.Column="0" Padding="12" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Available" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding AvailableAssetCount}" FontSize="20" FontAttributes="Bold" TextColor="#2E7D32" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="0" Grid.Column="1" Padding="12" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Assigned" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding AssignedAssetCount}" FontSize="20" FontAttributes="Bold" TextColor="#1565C0" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="0" Padding="12" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Maintenance" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding MaintenanceAssetCount}" FontSize="20" FontAttributes="Bold" TextColor="#EF6C00" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Retired" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding RetiredAssetCount}" FontSize="20" FontAttributes="Bold" TextColor="#757575" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Centered loading overlay during background loads -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           ZIndex="10"
                           Color="#512BD4" />
    </Grid>
</ContentPage>